
@using Microsoft.AspNetCore.Http
@{
    // nombre d'articles du panier, lu dans la session (0 s'il n'y en a pas)
    int nombreArticles = Context.Session.GetInt32("NombreArticles") ?? 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EpicerieAlda</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EpicerieAlda.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="position">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark entete border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div class="titre">
                <div>
                    <img src="~/Image/logo.jpg" alt="image" class="logo" />
                </div>
                <div class="NomEpicerie">Alda</div>
                </div>
                <button class="navbar-toggler lien" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 sousTitre">
                        <li class="nav-item">
                            <a class="nav-link text-white lien" asp-area="" asp-controller="Acceuil" asp-action="Index">Acceuil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white lien" asp-area="" asp-controller="Produit" asp-action="Index">Produits</a>
                        </li>
                    </ul>
                    <ul class="list">
                        <li>
                            <a asp-controller="Commande" asp-action="Index" class="lienPanier">
    <img src="~/Image/panier.jpg" alt="Mon panier" class="panier" />
    @if (nombreArticles > 0)
    {
        <span class="pastillePanier">@nombreArticles</span>
    }
</a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-white pied">
        <div class="container ">
            &copy;  Epicerie en ligne - Alda - crée par David Doubany molmou 
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstraundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>