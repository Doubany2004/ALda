@model List<EpicerieAlda.Models.Produit>
@{
    ViewData["Title"] = "Produits";
}

<div class="container">

    <h1 class="titreProduit">Nos produits</h1>
    <p class="phraseProduit">Découvrez tous nos produits, classés par rayon.</p>

    @if (Model.Count == 0)
    {
        <p>Aucun produit pour le moment.</p>
    }

    @* une section par catégorie *@
    @foreach (var groupe in Model.GroupBy(p => p.Categorie!.Nom))
    {
        <h2 class="titreCategorie">@groupe.Key</h2>

        <div class="grilleProduits">

            @* une carte par produit de cette catégorie *@
            @foreach (var p in groupe)
            {
                <div class="carteProduit">
                    <img src="@p.ImageUrl" alt="@p.Nom " class="imageProduit"/>
                    <h3>@p.Nom</h3>

                    @if (!string.IsNullOrEmpty(p.Description))
                    {
                        <small class="desciptionProduit">@p.Description</small>
                    }
       
                    <p class="prixProduit">@p.Prix.ToString("0.00") $</p>

                    @* bouton : envoie l'Id du produit à CommandeController.Ajouter *@
                    <form asp-controller="Commande" asp-action="AjouterProduitAuPanier" method="post" class="px-3 pt-2">
                        <input type="hidden" name="produitId" value="@p.Id" />
                        <button type="submit" class="AjouterBouton">+Ajouter</button>
                    </form>
                </div>
            }

        </div>
    }

</div>